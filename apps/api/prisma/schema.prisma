datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Document {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  category  String?
  filename  String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  deletedAt DateTime?
}

enum Role {
  ADMIN
  EDITOR
  USER
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String

  roles        UserRole[]
  refreshTokens RefreshToken[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model UserRole {
  userId String
  role   Role

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}