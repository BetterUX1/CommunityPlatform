datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  createdAt DateTime @default(now())
}

model Document {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  category  String?
  filename  String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  deletedAt DateTime?
}